# ===========================================
# CFX-DB Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Convex Configuration
# --------------------
# Get these from your Convex dashboard at https://dashboard.convex.dev
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=prod:your-deploy-key-here

# JWT Authentication
# ------------------
# Secret key for signing player JWTs (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-minimum-32-characters
JWT_ISSUER=cfx-db
JWT_EXPIRY_SECONDS=3600

# Connection Pool
# ---------------
# Number of HTTP clients to maintain for parallel queries
CONNECTION_POOL_SIZE=5

# Maximum time to wait for a connection from the pool (ms)
CONNECTION_TIMEOUT_MS=5000

# Health check interval (ms)
HEALTH_CHECK_INTERVAL_MS=30000

# Cache Configuration
# -------------------
# Maximum memory for cache in MB
CACHE_MAX_MEMORY_MB=256

# Default TTL for cached data (ms)
CACHE_DEFAULT_TTL_MS=30000

# Batch Writer Configuration
# --------------------------
# Maximum mutations per batch
BATCH_MAX_SIZE=50

# Flush interval for normal priority writes (ms)
BATCH_FLUSH_INTERVAL_MS=50

# Sync Configuration
# ------------------
# Default throttle for sync updates to clients (ms)
SYNC_THROTTLE_DEFAULT_MS=100

# Prefix for statebag keys
SYNC_STATEBAG_PREFIX=cfxdb

# Logging
# -------
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable performance metrics logging
LOG_PERFORMANCE_METRICS=true

# Server Identification
# ---------------------
# Unique identifier for this FiveM server (used in JWTs)
FIVEM_SERVER_ID=my-fivem-server
